{ 
  "import_pheweb.annotation_filepath": "gs://r5v2-data-green/annotation/R5V2_annotated_variants.gz",
  "import_pheweb.annotation_tbi_filepath": "gs://r5v2-data-green/annotation/R5V2_annotated_variants.gz.tbi",
  "import_pheweb.pheno.compress_manhattan": true,
  "import_pheweb.docker": "europe-west1-docker.pkg.dev/phewas-development/fg-phewas-registry/pheweb:ci-3412ca4d6da39a4bf05e57190a9b2b186d6f20df",
  "import_pheweb.summary_files": "gs://r5v2-data-green/import/r5_sumstat_files_one_pheno.txt",
  "import_pheweb.custom_json": "gs://r5v2-data-green/import/r5_one_pheno.json",
  "import_pheweb.disk": 6000,
  "import_pheweb.matrix.cpu": 8,
  "import_pheweb.mem": 64,
  "import_pheweb.file_affix": "finngen_R5_",
  "import_pheweb.bed_file": "gs://r13-data-green/annotation/genes-b38-v39.no_PAR_Y.bed",
  "import_pheweb.fields": [
    "phenocode",
    "phenostring",
    "category",
    "category_index",
    "num_cases",
    "num_controls"
  ],

  "import_pheweb.output_url": [
    "gs://r5v2-data-green"
  ],
  "import_pheweb.preprocess.chrom_column": "#chrom",
  "import_pheweb.preprocess.pos_column": "pos",
  "import_pheweb.preprocess.ref_column": "ref",
  "import_pheweb.preprocess.alt_column": "alt",
  "import_pheweb.preprocess.pval_column": "pval",
  "import_pheweb.preprocess.mlogp_column": "mlogp",
  "import_pheweb.preprocess.beta_column": "beta",
  "import_pheweb.preprocess.se_beta_column": "sebeta",
  "import_pheweb.preprocess.mem": 8,
  "import_pheweb.annotation.non_alt_loci_set": "gs://public-download-files/hgnc/json/json/non_alt_loci_set.json",
  "import_pheweb.matrix_longformat.mem": 16,
  "import_pheweb.filter_sumstat.pheno_col": "#pheno",
  "import_pheweb.filter_sumstat.columns": [
    "#pheno",
    "#chrom",
    "pos",
    "ref",
    "alt",
    "mlogp",
    "beta",
    "sebeta",
    "af_alt",
    "af_alt_cases",
    "af_alt_controls"
  ],
  "import_pheweb.pval_thres": 0.05,
  "import_pheweb.matrix_longformat.out_columns": [
    "#pheno",
    "chr",
    "pos",
    "ref",
    "alt",
    "mlogp",
    "beta",
    "sebeta",
    "af_alt",
    "af_alt_cases",
    "af_alt_controls"
  ],
  "import_pheweb.matrix_longformat.cpu": 6,
  "import_pheweb.generate_longformat_matrix": true,
  "import_pheweb.matrix_longformat.batch_size": 16,
  "import_pheweb.preprocess.preprocessor" : "awk -v cols=\"#chrom pos ref alt pval beta sebeta af_alt af_alt_cases af_alt_controls\" 'BEGIN {FS=OFS=\"\\t\"; n=split(cols, col_list, \" \"); alias[\"maf\"]=\"af_alt\"; alias[\"maf_cases\"]=\"af_alt_cases\"; alias[\"maf_controls\"]=\"af_alt_controls\"} NR==1 {for (i=1; i<=NF; i++) {col_idx[$i]=i; if (($i in alias) && !(alias[$i] in col_idx)) col_idx[alias[$i]]=i}; for (i=1; i<=n; i++) printf (i>1?OFS:\"\") col_list[i]; printf \"\\n\"} NR>1 {for (i=1; i<=n; i++) printf (i>1?OFS:\"\") (col_list[i] in col_idx ? $col_idx[col_list[i]] : \"NA\"); printf \"\\n\"}'"
}
